#!/bin/sh
# X12 reference window manager — twm engine with X12 defaults (ADR-0019).
set -eu

BINDIR="@BINDIR@"
DATADIR="@DATADIR@"
TWM="${XWM_TWM:-$BINDIR/twm}"
SYS_RC="${XWM_SYSTEM_RC:-$DATADIR/X11/xwm/system.xwmrc}"
USER_RC="${XWM_RC:-${HOME:+$HOME/.xwmrc}}"

if [ ! -x "$TWM" ]; then
  # Uninstalled / build-tree fallback
  if [ -x "${X12_BUILD_DIR:-}/app/twm/twm" ]; then
    TWM="${X12_BUILD_DIR}/app/twm/twm"
  elif command -v twm >/dev/null 2>&1; then
    TWM="$(command -v twm)"
  else
    echo "xwm: twm not found (set XWM_TWM or build app/twm)" >&2
    exit 127
  fi
fi

# Honor explicit -file / -f from the user; otherwise prefer ~/.xwmrc, then system.
has_file=0
for a in "$@"; do
  case "$a" in
    -f|-file|--file) has_file=1; break ;;
  esac
done

if [ "$has_file" -eq 0 ]; then
  if [ -n "${USER_RC:-}" ] && [ -f "$USER_RC" ]; then
    exec "$TWM" -f "$USER_RC" "$@"
  fi
  if [ -f "$SYS_RC" ]; then
    exec "$TWM" -f "$SYS_RC" "$@"
  fi
fi

exec "$TWM" "$@"
